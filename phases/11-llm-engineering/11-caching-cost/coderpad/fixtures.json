{
  "core": {
    "function": "cache_replay",
    "cases": [
      {
        "args": [
          [
            {
              "op": "put",
              "key": "a",
              "time": 0,
              "value": 1
            },
            {
              "op": "get",
              "key": "a",
              "time": 1
            },
            {
              "op": "get",
              "key": "a",
              "time": 2
            }
          ],
          2
        ],
        "expected": [
          1,
          null
        ]
      },
      {
        "args": [
          [
            {
              "op": "get",
              "key": "a",
              "time": 0
            }
          ],
          1
        ],
        "expected": [
          null
        ]
      },
      {
        "args": [
          [],
          1
        ],
        "expected": []
      },
      {
        "args": [
          [
            {
              "op": "put",
              "key": "a",
              "time": 0,
              "value": 0
            },
            {
              "op": "get",
              "key": "a",
              "time": 0
            }
          ],
          0
        ],
        "expected": [
          null
        ]
      },
      {
        "args": [
          [],
          -1
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            {
              "op": "delete",
              "key": "a",
              "time": 0
            }
          ],
          1
        ],
        "raises": "ValueError"
      }
    ]
  },
  "bonus": {
    "function": "token_cost",
    "cases": [
      {
        "args": [
          [
            {
              "provider": "a",
              "input_tokens": 2,
              "output_tokens": 3
            }
          ],
          {
            "a": [
              1,
              2
            ]
          }
        ],
        "expected": {
          "total": 8,
          "by_provider": {
            "a": 8
          }
        }
      },
      {
        "args": [
          [
            {
              "provider": "x",
              "input_tokens": 1,
              "output_tokens": 1
            }
          ],
          {}
        ],
        "raises": "KeyError"
      }
    ]
  }
}
