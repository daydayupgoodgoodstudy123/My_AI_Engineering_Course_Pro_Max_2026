      },
      {
        "args": [
          [
            {
              "ok": false,
              "latency": 1
            }
          ],
          0,
          5
        ],
        "expected": "rollback"
      },
      {
        "args": [
          [
            {
              "ok": true,
              "latency": 6
            }
          ],
          0,
          5
        ],
        "expected": "rollback"
      },
      {
        "args": [
          [],
          0,
          5
        ],
        "expected": "insufficient"
      },
      {
        "args": [
          [],
          2,
          5
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            {
              "ok": true,
              "latency": 1
            },
            {
              "ok": false,
              "latency": 1
            }
          ],
          0.5,
          5
        ],
        "expected": "promote"
      }
    ]
  },
