{
  "core": {
    "function": "permission_decision",
    "cases": [
      {
        "args": [
          "write",
          [
            "write"
          ],
          true,
          false
        ],
        "expected": "ask"
      },
      {
        "args": [
          "write",
          [
            "write"
          ],
          true,
          true
        ],
        "expected": "allow"
      },
      {
        "args": [
          "write",
          [],
          true,
          true
        ],
        "expected": "deny"
      },
      {
        "args": [
          "read",
          [
            "read"
          ],
          false,
          false
        ],
        "expected": "allow"
      },
      {
        "args": [
          "x",
          [],
          1,
          false
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          "x",
          [],
          false,
          false
        ],
        "expected": "deny"
      }
    ]
  },
  "bonus": {
    "function": "contained_path",
    "cases": [
      {
        "args": [
          "/work",
          "a/../b"
        ],
        "expected": "/work/b"
      },
      {
        "args": [
          "/work",
          "/secret"
        ],
        "raises": "ValueError"
      }
    ]
  }
}
