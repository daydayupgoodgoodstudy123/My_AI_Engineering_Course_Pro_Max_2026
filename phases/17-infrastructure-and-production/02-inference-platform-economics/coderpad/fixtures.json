{
  "core": {
    "function": "token_cost",
    "cases": [
      {
        "args": [
          [
            {
              "provider": "a",
              "input_tokens": 2,
              "output_tokens": 3
            }
          ],
          {
            "a": [
              1,
              2
            ]
          }
        ],
        "expected": {
          "total": 8,
          "by_provider": {
            "a": 8
          }
        }
      },
      {
        "args": [
          [],
          {}
        ],
        "expected": {
          "total": 0,
          "by_provider": {}
        }
      },
      {
        "args": [
          [
            {
              "provider": "a",
              "input_tokens": -1,
              "output_tokens": 0
            }
          ],
          {
            "a": [
              1,
              1
            ]
          }
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            {
              "provider": "a",
              "input_tokens": true,
              "output_tokens": 0
            }
          ],
          {
            "a": [
              1,
              1
            ]
          }
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            {
              "provider": "x",
              "input_tokens": 1,
              "output_tokens": 1
            }
          ],
          {}
        ],
        "raises": "KeyError"
      },
      {
        "args": [
          [
            {
              "provider": "a",
              "input_tokens": 0,
              "output_tokens": 0
            }
          ],
          {
            "a": [
              1,
              1
            ]
          }
        ],
        "expected": {
          "total": 0,
          "by_provider": {
            "a": 0
          }
        }
      }
    ]
  },
  "bonus": {
    "function": "amdahl",
    "cases": [
      {
        "args": [
          0.5,
          2
        ],
        "expected": 1.3333333333333333
      },
      {
        "args": [
          0.5,
          0.5
        ],
        "raises": "ValueError"
      }
    ]
  }
}
