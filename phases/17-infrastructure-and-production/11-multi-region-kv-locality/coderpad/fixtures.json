{
  "core": {
    "function": "lru_keys",
    "cases": [
      {
        "args": [
          [
            "a",
            "b",
            "a",
            "c"
          ],
          2
        ],
        "expected": [
          "a",
          "c"
        ]
      },
      {
        "args": [
          [],
          2
        ],
        "expected": []
      },
      {
        "args": [
          [
            "a"
          ],
          0
        ],
        "expected": []
      },
      {
        "args": [
          [
            "a",
            "a"
          ],
          2
        ],
        "expected": [
          "a"
        ]
      },
      {
        "args": [
          [],
          -1
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            "a",
            "b"
          ],
          1
        ],
        "expected": [
          "b"
        ]
      }
    ]
  },
  "bonus": {
    "function": "cache_replay",
    "cases": [
      {
        "args": [
          [
            {
              "op": "put",
              "key": "a",
              "time": 0,
              "value": 1
            },
            {
              "op": "get",
              "key": "a",
              "time": 1
            },
            {
              "op": "get",
              "key": "a",
              "time": 2
            }
          ],
          2
        ],
        "expected": [
          1,
          null
        ]
      },
      {
        "args": [
          [
            {
              "op": "delete",
              "key": "a",
              "time": 0
            }
          ],
          1
        ],
        "raises": "ValueError"
      }
    ]
  }
}
