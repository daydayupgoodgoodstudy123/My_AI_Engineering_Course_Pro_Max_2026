{
  "core": {
    "function": "rate_limit",
    "cases": [
      {
        "args": [
          [
            0,
            0,
            1,
            10
          ],
          10,
          2
        ],
        "expected": [
          true,
          true,
          false,
          true
        ]
      },
      {
        "args": [
          [],
          1,
          1
        ],
        "expected": []
      },
      {
        "args": [
          [
            0,
            1
          ],
          1,
          1
        ],
        "expected": [
          true,
          true
        ]
      },
      {
        "args": [
          [
            0,
            0,
            0
          ],
          1,
          1
        ],
        "expected": [
          true,
          false,
          false
        ]
      },
      {
        "args": [
          [
            1,
            0
          ],
          1,
          1
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [],
          0,
          1
        ],
        "raises": "ValueError"
      }
    ]
  },
  "bonus": {
    "function": "latency_report",
    "cases": [
      {
        "args": [
          [
            1,
            2,
            3,
            4
          ],
          2
        ],
        "expected": {
          "p50": 2,
          "p95": 4,
          "goodput_fraction": 0.5
        }
      },
      {
        "args": [
          [
            -1
          ],
          1
        ],
        "raises": "ValueError"
      }
    ]
  }
}
