{
  "core": {
    "function": "canary_decision",
    "cases": [
      {
        "args": [
          [
            {
              "ok": true,
              "latency": 5
            }
          ],
          0,
          5
        ],
        "expected": "promote"
      },
      {
        "args": [
          [
            {
              "ok": false,
              "latency": 1
            }
          ],
          0,
          5
        ],
        "expected": "rollback"
      },
      {
        "args": [
          [
            {
              "ok": true,
              "latency": 6
            }
          ],
          0,
          5
        ],
        "expected": "rollback"
      },
      {
        "args": [
          [],
          0,
          5
        ],
        "expected": "insufficient"
      },
      {
        "args": [
          [],
          2,
          5
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            {
              "ok": true,
              "latency": 1
            },
            {
              "ok": false,
              "latency": 1
            }
          ],
          0.5,
          5
        ],
        "expected": "promote"
      }
    ]
  },
  "bonus": {
    "function": "latency_report",
    "cases": [
      {
        "args": [
          [
            1,
            2,
            3,
            4
          ],
          2
        ],
        "expected": {
          "p50": 2,
          "p95": 4,
          "goodput_fraction": 0.5
        }
      },
      {
        "args": [
          [
            -1
          ],
          1
        ],
        "raises": "ValueError"
      }
    ]
  }
}
