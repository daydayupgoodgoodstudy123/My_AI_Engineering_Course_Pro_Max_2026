{
  "core": {
    "function": "environment_report",
    "cases": [
      {
        "args": [
          {
            "python": {
              "exit_code": 0,
              "output": "3.12"
            }
          },
          [
            "python"
          ]
        ],
        "expected": {
          "ready": true,
          "missing": [],
          "failed": []
        }
      },
      {
        "args": [
          {},
          [
            "python"
          ]
        ],
        "expected": {
          "ready": false,
          "missing": [
            "python"
          ],
          "failed": []
        }
      },
      {
        "args": [
          {
            "x": {
              "exit_code": 1,
              "output": "bad"
            }
          },
          [
            "x"
          ]
        ],
        "expected": {
          "ready": false,
          "missing": [],
          "failed": [
            "x"
          ]
        }
      },
      {
        "args": [
          {},
          []
        ],
        "expected": {
          "ready": true,
          "missing": [],
          "failed": []
        }
      },
      {
        "args": [
          {
            "x": {
              "exit_code": 0,
              "output": " "
            }
          },
          [
            "x"
          ]
        ],
        "expected": {
          "ready": false,
          "missing": [],
          "failed": [
            "x"
          ]
        }
      },
      {
        "args": [
          {},
          [
            "b",
            "a",
            "a"
          ]
        ],
        "expected": {
          "ready": false,
          "missing": [
            "a",
            "b"
          ],
          "failed": []
        }
      }
    ]
  },
  "bonus": {
    "function": "command_review",
    "cases": [
      {
        "args": [
          [
            "python3",
            "check.py"
          ],
          [
            [
              "python3",
              "check.py"
            ]
          ]
        ],
        "expected": true
      },
      {
        "args": [
          [
            "python3",
            "check.py",
            "--upload"
          ],
          [
            [
              "python3",
              "check.py"
            ]
          ]
        ],
        "expected": false
      }
    ]
  }
}
