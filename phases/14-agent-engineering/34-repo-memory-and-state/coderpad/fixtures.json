{
  "core": {
    "function": "compact_memory",
    "cases": [
      {
        "args": [
          [
            {
              "id": "a",
              "timestamp": 1,
              "text": "old"
            },
            {
              "id": "a",
              "timestamp": 2,
              "text": "new"
            }
          ],
          1
        ],
        "expected": [
          {
            "id": "a",
            "timestamp": 2,
            "text": "new"
          }
        ]
      },
      {
        "args": [
          [],
          1
        ],
        "expected": []
      },
      {
        "args": [
          [
            {
              "id": "a",
              "timestamp": 1,
              "text": "x"
            }
          ],
          0
        ],
        "expected": []
      },
      {
        "args": [
          [
            {
              "id": "b",
              "timestamp": 1,
              "text": "b"
            },
            {
              "id": "a",
              "timestamp": 1,
              "text": "a"
            }
          ],
          1
        ],
        "expected": [
          {
            "id": "a",
            "timestamp": 1,
            "text": "a"
          }
        ]
      },
      {
        "args": [
          [],
          -1
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            {
              "id": "a",
              "timestamp": 1,
              "text": "x"
            },
            {
              "id": "a",
              "timestamp": 1,
              "text": "y"
            }
          ],
          1
        ],
        "expected": [
          {
            "id": "a",
            "timestamp": 1,
            "text": "y"
          }
        ]
      }
    ]
  },
  "bonus": {
    "function": "manifest",
    "cases": [
      {
        "args": [
          {
            "a": ""
          }
        ],
        "expected": {
          "a": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        }
      },
      {
        "args": [
          {
            "/a": ""
          }
        ],
        "raises": "ValueError"
      }
    ]
  }
}
