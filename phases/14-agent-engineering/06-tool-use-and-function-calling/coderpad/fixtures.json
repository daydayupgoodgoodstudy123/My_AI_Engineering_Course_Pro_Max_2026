{
  "core": {
    "function": "validate_arguments",
    "cases": [
      {
        "args": [
          {
            "x": "integer"
          },
          {
            "x": 2
          }
        ],
        "expected": true
      },
      {
        "args": [
          {
            "x": "integer"
          },
          {
            "x": true
          }
        ],
        "expected": false
      },
      {
        "args": [
          {
            "x": "string"
          },
          {
            "x": "a",
            "extra": 1
          }
        ],
        "expected": false
      },
      {
        "args": [
          {},
          {}
        ],
        "expected": true
      },
      {
        "args": [
          {
            "x": "boolean"
          },
          {
            "x": 1
          }
        ],
        "expected": false
      },
      {
        "args": [
          {
            "x": "number"
          },
          {
            "x": 1
          }
        ],
        "expected": false
      }
    ]
  },
  "bonus": {
    "function": "replay_requests",
    "cases": [
      {
        "args": [
          [
            {
              "id": "a",
              "payload": 1
            },
            {
              "id": "a",
              "payload": 1
            }
          ]
        ],
        "expected": {
          "executed": [
            "a"
          ],
          "replayed": [
            "a"
          ]
        }
      },
      {
        "args": [
          [
            {
              "id": "a",
              "payload": 1
            },
            {
              "id": "a",
              "payload": true
            }
          ]
        ],
        "raises": "ValueError"
      }
    ]
  }
}
