{
  "package": "specmodes",
  "tests": [
    "test_executable_specification",
    "test_decision_revision_journal",
    "test_proof_matches_claim",
    "test_private_policy_stream",
    "test_boundary_ast"
  ],
  "layers": [
    {
      "test": "test_executable_specification",
      "steps": [
        {
          "name": "as shipped",
          "edits": [],
          "expect": "AttributeError"
        },
        {
          "name": "require executable bounded policy",
          "edits": [
            {
              "file": "contract.py",
              "old": "if kind=='bounded' and not decision.rationale.strip():",
              "new": "if kind=='bounded' and not valid_boundary(decision.boundary):"
            }
          ],
          "expect": "examples must include normal edge failure"
        },
        {
          "name": "require all four example kinds",
          "edits": [
            {
              "file": "contract.py",
              "old": "if not spec.examples or any(not e.text.strip() for e in spec.examples):",
              "new": "if not spec.examples or any(not e.text.strip() for e in spec.examples) or not {'normal','edge','failure','forbidden'}<={e.kind for e in spec.examples}:"
            }
          ],
          "expect": "human checkpoints preserve the rationale"
        },
        {
          "name": "preserve locked rationale bindings",
          "edits": [
            {
              "file": "contract.py",
              "old": "else:result['checkpoints'].append({'id':d.id,'question':d.question})",
              "new": "else:result['checkpoints'].append({'id':d.id,'question':d.question,'rationale':d.rationale})"
            }
          ],
          "expect": "compile a catalog without repeatedly shifting"
        },
        {
          "name": "compile catalog in an ordered pass",
          "edits": [
            {
              "file": "contract.py",
              "old": "pending=list(values);result=[]\n    while pending:result.append((len(result)+1,pending.pop(0)))\n    return tuple(result)",
              "new": "return tuple(enumerate(values,1))"
            }
          ],
          "expect": "PASSED"
        }
      ]
    }
  ],
  "wrong_fixes": [
    {
      "test": "test_executable_specification",
      "name": "deduplicate and sort the allowed catalog",
      "edits": [
        {
          "file": "contract.py",
          "old": "return tuple(enumerate(values,1))",
          "new": "return tuple(enumerate(sorted(set(values)),1))"
        }
      ],
      "expect": "numeric-free allowlists are executable ordered boundaries"
    },
    {
      "test": "test_executable_specification",
      "name": "require delegated rationale too",
      "edits": [
        {
          "file": "contract.py",
          "old": "if kind!='delegated' and not decision.rationale.strip():",
          "new": "if not decision.rationale.strip():"
        }
      ],
      "expect": "numeric-free allowlists are executable ordered boundaries"
    },
    {
      "test": "test_decision_revision_journal",
      "name": "replay latest events for any requested prefix",
      "edits": [
        {
          "file": "history.py",
          "old": "for event in events[:last]:",
          "new": "for event in events:"
        }
      ],
      "expect": "revision prefixes reproduce historic decisions"
    },
    {
      "test": "test_decision_revision_journal",
      "name": "replace explicit empty rationale with old reason",
      "edits": [
        {
          "file": "history.py",
          "old": "if event['rationale'] is not None:",
          "new": "if event['rationale']:"
        }
      ],
      "expect": "updates affect only their id"
    },
    {
      "test": "test_decision_revision_journal",
      "name": "reset boundary when the mode changes",
      "edits": [
        {
          "file": "history.py",
          "old": "if event['operation']=='mode':changes['mode']=event['new_mode']",
          "new": "if event['operation']=='mode':changes['mode']=event['new_mode'];changes['boundary']=None"
        }
      ],
      "expect": "updates affect only their id"
    },
    {
      "test": "test_decision_revision_journal",
      "name": "accept a gap in revision numbers",
      "edits": [
        {
          "file": "history.py",
          "old": "event.number!=len(events)+1",
          "new": "event.number<len(events)+1"
        }
      ],
      "expect": "DID NOT RAISE"
    },
    {
      "test": "test_proof_matches_claim",
      "name": "treat audit as universal proof",
      "edits": [
        {
          "file": "proof.py",
          "old": "elif r.kind!=MATCH[claim.kind]:",
          "new": "elif r.kind not in (MATCH[claim.kind],'audit'):"
        }
      ],
      "expect": "audit evidence cannot freely substitute"
    },
    {
      "test": "test_proof_matches_claim",
      "name": "ignore explicit claim binding",
      "edits": [
        {
          "file": "proof.py",
          "old": "elif claim.id not in r.claim_ids:",
          "new": "elif False:"
        }
      ],
      "expect": "receipt names must explicitly bind"
    },
    {
      "test": "test_proof_matches_claim",
      "name": "allow any passing case instead of coverage",
      "edits": [
        {
          "file": "proof.py",
          "old": "if not set(claim.cases)<=covered:",
          "new": "if not covered:"
        }
      ],
      "expect": "audit evidence cannot freely substitute"
    },
    {
      "test": "test_proof_matches_claim",
      "name": "ignore a failed receipt if another covers all cases",
      "edits": [
        {
          "file": "proof.py",
          "old": "results.append(ProofResult(claim.id,not reasons,tuple(reasons)))",
          "new": "results.append(ProofResult(claim.id,set(claim.cases)<=covered,() if set(claim.cases)<=covered else tuple(reasons)))"
        }
      ],
      "expect": "another good receipt cannot excuse"
    },
    {
      "test": "test_private_policy_stream",
      "name": "apply locked attempt before asking for checkpoint",
      "edits": [
        {
          "file": "runtime.py",
          "old": "if mode(current.mode)=='locked':",
          "new": "if mode(current.mode)=='locked':\n            apply(attempt)"
        }
      ],
      "expect": "locked checkpoint outranks simultaneous budgets"
    },
    {
      "test": "test_private_policy_stream",
      "name": "require two budgets to fail before stopping",
      "edits": [
        {
          "file": "runtime.py",
          "old": "        if reasons:",
          "new": "        if len(reasons)>1:"
        }
      ],
      "expect": "numeric-free allowed dependencies are enforced"
    },
    {
      "test": "test_private_policy_stream",
      "name": "use strict greater than for stop thresholds",
      "edits": [
        {
          "file": "runtime.py",
          "old": "values[b.metric]>=canonical_limit(b)",
          "new": "values[b.metric]>canonical_limit(b)"
        }
      ],
      "expect": "terminal policy must not pull future attempts"
    },
    {
      "test": "test_private_policy_stream",
      "name": "keep consuming after a stop packet",
      "edits": [
        {
          "file": "runtime.py",
          "old": "yield packet('stop',current.id,reasons)\n            return",
          "new": "yield packet('stop',current.id,reasons)\n            continue"
        }
      ],
      "expect": "terminal policy must not pull future attempts"
    },
    {
      "test": "test_boundary_ast",
      "name": "treat ALL like ANY",
      "edits": [
        {
          "file": "ast.py",
          "old": "all(ok for ok,_ in results) if kind=='all'",
          "new": "any(ok for ok,_ in results) if kind=='all'"
        }
      ],
      "expect": "failing groups collect every blocking occurrence"
    },
    {
      "test": "test_boundary_ast",
      "name": "report failed siblings inside a passing ANY",
      "edits": [
        {
          "file": "ast.py",
          "old": "blocked=() if allowed else tuple",
          "new": "blocked=tuple"
        }
      ],
      "expect": "a passing ANY hides failed sibling"
    },
    {
      "test": "test_boundary_ast",
      "name": "return only the first blocking occurrence",
      "edits": [
        {
          "file": "ast.py",
          "old": "return {'allowed':allowed,'blocked':blocked}",
          "new": "return {'allowed':allowed,'blocked':blocked[:1]}"
        }
      ],
      "expect": "reaching either stop threshold blocks"
    },
    {
      "test": "test_boundary_ast",
      "name": "use metric names instead of occurrence paths",
      "edits": [
        {
          "file": "ast.py",
          "old": "return allowed,() if allowed else (path,)",
          "new": "return allowed,() if allowed else ((value['metric'],),)"
        }
      ],
      "expect": "reaching either stop threshold blocks"
    },
    {
      "test": "test_decision_revision_journal",
      "name": "keep an old boundary when a boundary revision explicitly clears it to None",
      "edits": [
        {
          "file": "history.py",
          "old": "else:changes['boundary']=decode_boundary(event['boundary'])",
          "new": "elif event['boundary'] is not None:changes['boundary']=decode_boundary(event['boundary'])"
        }
      ],
      "expect": "an explicit None boundary clears"
    },
    {
      "test": "test_decision_revision_journal",
      "name": "reject revision gaps but permit duplicate prior numbers",
      "edits": [
        {
          "file": "history.py",
          "old": "event.number!=len(events)+1",
          "new": "event.number>len(events)+1"
        }
      ],
      "expect": "DID NOT RAISE"
    },
    {
      "test": "test_proof_matches_claim",
      "name": "report receipt kind before the higher-priority failed status",
      "edits": [
        {
          "file": "proof.py",
          "old": "elif not r.passed:reason='failed:'+key\n            elif r.kind!=MATCH[claim.kind]:reason='kind:'+key",
          "new": "elif r.kind!=MATCH[claim.kind]:reason='kind:'+key\n            elif not r.passed:reason='failed:'+key"
        }
      ],
      "expect": "a failed receipt reports failed before kind"
    },
    {
      "test": "test_proof_matches_claim",
      "name": "allow an authority receipt scope to be a strict superset of the claim scope",
      "edits": [
        {
          "file": "proof.py",
          "old": "set(r.authority_scope)!=set(claim.authority_scope)",
          "new": "not set(claim.authority_scope)<=set(r.authority_scope)"
        }
      ],
      "expect": "authority scope must be exact rather than a superset"
    },
    {
      "test": "test_private_policy_stream",
      "name": "enforce source and elapsed budgets but skip an explicit retry budget",
      "edits": [
        {
          "file": "runtime.py",
          "old": "if b.kind=='limit' and values[b.metric]>=canonical_limit(b):",
          "new": "if b.kind=='limit' and b.metric!='retries' and values[b.metric]>=canonical_limit(b):"
        }
      ],
      "expect": "a global retry budget prevents"
    },
    {
      "test": "test_boundary_ast",
      "name": "report each local child index without its ancestor path prefix",
      "edits": [
        {
          "file": "ast.py",
          "old": "walk(child,path+(i,)) for i,child in enumerate(value)",
          "new": "walk(child,(i,)) for i,child in enumerate(value)"
        }
      ],
      "expect": "failing groups collect every blocking occurrence"
    },
    {
      "test": "test_decision_revision_journal",
      "name": "split Unicode string content instead of physical JSONL lines",
      "edits": [
        {
          "file": "history.py",
          "old": "    with path.open(encoding='utf-8') as file:\n        return [json.loads(line) for line in file]",
          "new": "    return [json.loads(line) for line in path.read_text(encoding='utf-8').splitlines()]"
        }
      ],
      "expect": "JSONDecodeError"
    }
  ]
}
