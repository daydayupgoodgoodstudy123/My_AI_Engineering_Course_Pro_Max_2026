{
  "core": {
    "function": "ngram_counts",
    "cases": [
      {
        "args": [
          [
            "a",
            "b",
            "a"
          ],
          1
        ],
        "expected": {
          "[\"a\"]": 2,
          "[\"b\"]": 1
        }
      },
      {
        "args": [
          [
            "a",
            "b",
            "a"
          ],
          2
        ],
        "expected": {
          "[\"a\", \"b\"]": 1,
          "[\"b\", \"a\"]": 1
        }
      },
      {
        "args": [
          [],
          2
        ],
        "expected": {}
      },
      {
        "args": [
          [
            "a"
          ],
          2
        ],
        "expected": {}
      },
      {
        "args": [
          [
            "a"
          ],
          0
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            "a"
          ],
          true
        ],
        "raises": "ValueError"
      }
    ]
  },
  "bonus": {
    "function": "inverse_cdf",
    "cases": [
      {
        "args": [
          [
            0.5,
            0.5
          ],
          [
            0,
            0.49,
            0.5,
            0.99
          ]
        ],
        "expected": [
          0,
          0,
          1,
          1
        ]
      },
      {
        "args": [
          [],
          []
        ],
        "raises": "ValueError"
      }
    ]
  }
}
