{
  "package": "leadsynth",
  "tests": [
    "test_completed_worker_receipts",
    "test_content_addressed_assignments",
    "test_scoped_conflict_synthesis",
    "test_worker_markdown_blocks",
    "test_broad_then_narrow_dossier"
  ],
  "layers": [
    {
      "test": "test_completed_worker_receipts",
      "steps": [
        {
          "name": "original narrow worker producer",
          "edits": [],
          "expect": "AttributeError"
        },
        {
          "name": "narrow summary artifact",
          "edits": [
            {
              "file": "workers.py",
              "old": "task.scope,observation.working_context,",
              "new": "task.scope,observation.summary,"
            }
          ],
          "expect": "each worker retains its own declared token cap"
        },
        {
          "name": "own worker cap",
          "edits": [
            {
              "file": "workers.py",
              "old": "cut=artifact.tokens>team_mean_cap",
              "new": "cut=artifact.tokens>own_cap"
            }
          ],
          "expect": "complete sealed worker receipt batches remain responsive"
        },
        {
          "name": "completed runtime median",
          "edits": [
            {
              "file": "workers.py",
              "old": "        self._seen.append(seconds)\n        ordered=sorted(self._seen);n=len(ordered)\n        return ordered[n//2] if n%2 else (ordered[n//2-1]+ordered[n//2])/2\n",
              "new": "        if not self._low or seconds<=-self._low[0]:heapq.heappush(self._low,-seconds)\n        else:heapq.heappush(self._high,seconds)\n        if len(self._low)>len(self._high)+1:heapq.heappush(self._high,-heapq.heappop(self._low))\n        elif len(self._high)>len(self._low):heapq.heappush(self._low,-heapq.heappop(self._high))\n        if len(self._low)==len(self._high):return (-self._low[0]+self._high[0])/2\n        return -self._low[0]\n"
            }
          ],
          "expect": "PASSED"
        }
      ]
    }
  ],
  "wrong_fixes": [
    {
      "test": "test_completed_worker_receipts",
      "name": "replace runtime median with last completion",
      "edits": [
        {
          "file": "workers.py",
          "old": "        if not self._low or seconds<=-self._low[0]:",
          "new": "        return seconds\n        if not self._low or seconds<=-self._low[0]:"
        }
      ],
      "expect": "every completion contributes"
    },
    {
      "test": "test_completed_worker_receipts",
      "name": "erase cut worker observed usage",
      "edits": [
        {
          "file": "workers.py",
          "old": "return replace(artifact,cut=artifact.tokens>own_cap)",
          "new": "return replace(artifact,cut=artifact.tokens>own_cap,tokens=min(artifact.tokens,own_cap))"
        }
      ],
      "expect": "cut outcomes preserve"
    },
    {
      "test": "test_content_addressed_assignments",
      "name": "normalize summary content before storage",
      "edits": [
        {
          "file": "artifacts.py",
          "old": "self.files.put_summary(item.summary)",
          "new": "self.files.put_summary(item.summary.strip())"
        }
      ],
      "expect": "reopening preserves"
    },
    {
      "test": "test_content_addressed_assignments",
      "name": "merge assignment identity by summary content",
      "edits": [
        {
          "file": "artifacts.py",
          "old": "        for item in artifacts:\n",
          "new": "        for item in {item.summary:item for item in artifacts}.values():\n"
        }
      ],
      "expect": "reopening preserves"
    },
    {
      "test": "test_content_addressed_assignments",
      "name": "narrow exact token counts through binary64",
      "edits": [
        {
          "file": "artifacts.py",
          "old": "'tokens':item.tokens",
          "new": "'tokens':float(item.tokens)"
        }
      ],
      "expect": "reopening preserves"
    },
    {
      "test": "test_scoped_conflict_synthesis",
      "name": "accept claims outside worker scope",
      "edits": [
        {
          "file": "synthesis.py",
          "old": "('scope' if claim.topic not in artifact.scope else None)",
          "new": "None"
        }
      ],
      "expect": "out of scope and cut-worker"
    },
    {
      "test": "test_scoped_conflict_synthesis",
      "name": "count repeated same-source claims as independent evidence",
      "edits": [
        {
          "file": "synthesis.py",
          "old": "            if source not in alt['source_ids']:alt['source_ids'].append(source)",
          "new": "            alt['source_ids'].append(source)"
        }
      ],
      "expect": "contradictory exact values"
    },
    {
      "test": "test_scoped_conflict_synthesis",
      "name": "discard contradictory alternative in favor of first value",
      "edits": [
        {
          "file": "synthesis.py",
          "old": "        alternatives=list(values.values());entry=",
          "new": "        alternatives=list(values.values())[:1];entry="
        }
      ],
      "expect": "contradictory exact values"
    },
    {
      "test": "test_scoped_conflict_synthesis",
      "name": "issue followups after budget exhaustion",
      "edits": [
        {
          "file": "synthesis.py",
          "old": "        if budget<=0:continue",
          "new": "        if budget<0:continue"
        }
      ],
      "expect": "exhausted followup budgets"
    },
    {
      "test": "test_worker_markdown_blocks",
      "name": "publish missing subanswers as complete",
      "edits": [
        {
          "file": "stream.py",
          "old": "status='missing';body=event['error']",
          "new": "status='complete';body=event['error']"
        }
      ],
      "expect": "each Markdown block"
    },
    {
      "test": "test_worker_markdown_blocks",
      "name": "publish worker question instead of summary body",
      "edits": [
        {
          "file": "stream.py",
          "old": "body=event['artifact'].summary",
          "new": "body=event['question']"
        }
      ],
      "expect": "each Markdown block"
    },
    {
      "test": "test_worker_markdown_blocks",
      "name": "drop unresolved contradictions from final lead section",
      "edits": [
        {
          "file": "stream.py",
          "old": "'conflicting':report['conflicting']",
          "new": "'conflicting':[]"
        }
      ],
      "expect": "the lead block retains"
    },
    {
      "test": "test_broad_then_narrow_dossier",
      "name": "allow a followup scope equal to its parent",
      "edits": [
        {
          "file": "worktree.py",
          "old": "not set(child['scope'])<set(node['scope'])",
          "new": "not set(child['scope'])<=set(node['scope'])"
        }
      ],
      "expect": "a followup must narrow"
    },
    {
      "test": "test_broad_then_narrow_dossier",
      "name": "charge only direct children against a branch budget",
      "edits": [
        {
          "file": "worktree.py",
          "old": "if descendants>node['budget']",
          "new": "if len(node['children'])>node['budget']"
        }
      ],
      "expect": "each branch budget counts"
    },
    {
      "test": "test_broad_then_narrow_dossier",
      "name": "relabel foreign leaf evidence as its assigned question",
      "edits": [
        {
          "file": "worktree.py",
          "old": "artifact.question_id!=node['question_id'] or ",
          "new": ""
        }
      ],
      "expect": "a followup must narrow"
    },
    {
      "test": "test_content_addressed_assignments",
      "name": "append prior assignments instead of replacing a query snapshot",
      "edits": [
        {
          "file": "artifacts.py",
          "old": "        self.files.write_manifest(query_id,{'query_id':query_id,'assignments':rows})",
          "new": "        try:prior=self.files.read_manifest(query_id)['assignments']\n        except FileNotFoundError:prior=[]\n        self.files.write_manifest(query_id,{'query_id':query_id,'assignments':prior+rows})"
        }
      ],
      "expect": "saving a query replaces its ordered assignment snapshot"
    },
    {
      "test": "test_scoped_conflict_synthesis",
      "name": "accept claim evidence from cut worker artifacts",
      "edits": [
        {
          "file": "synthesis.py",
          "old": "reason='cut' if artifact.cut else ('scope' if claim.topic not in artifact.scope else None)",
          "new": "reason=('scope' if claim.topic not in artifact.scope else None)"
        }
      ],
      "expect": "out of scope and cut-worker"
    },
    {
      "test": "test_scoped_conflict_synthesis",
      "name": "alphabetize source provenance instead of preserving first seen order",
      "edits": [
        {
          "file": "synthesis.py",
          "old": "    report={'supported':[],'unverified':[],'conflicting':[]}",
          "new": "    for values in grouped.values():\n        for alt in values.values():alt['source_ids'].sort()\n    report={'supported':[],'unverified':[],'conflicting':[]}"
        }
      ],
      "expect": "evidence provenance preserves first-seen union order"
    },
    {
      "test": "test_scoped_conflict_synthesis",
      "name": "borrow another claim budget for a targeted followup",
      "edits": [
        {
          "file": "synthesis.py",
          "old": "claim_id=conflict['claim_id'];budget=budgets.get(claim_id,0)",
          "new": "claim_id=conflict['claim_id'];budget=max(budgets.values(),default=0)"
        }
      ],
      "expect": "a targeted followup addresses only"
    },
    {
      "test": "test_worker_markdown_blocks",
      "name": "append private worker context to published narrow summary",
      "edits": [
        {
          "file": "stream.py",
          "old": "            body=event['artifact'].summary",
          "new": "            body=event['artifact'].summary+''.join(event.get('working_context',()))"
        }
      ],
      "expect": "each Markdown block"
    },
    {
      "test": "test_worker_markdown_blocks",
      "name": "treat an empty completed summary as a missing worker outcome",
      "edits": [
        {
          "file": "stream.py",
          "old": "        if event['artifact'] is None:",
          "new": "        if event['artifact'] is None or not event['artifact'].summary:"
        }
      ],
      "expect": "an empty completed summary remains a complete worker outcome"
    },
    {
      "test": "test_broad_then_narrow_dossier",
      "name": "discard unresolved claims at internal supervisor nodes",
      "edits": [
        {
          "file": "worktree.py",
          "old": "            unresolved.append((here,tuple(node['unresolved'])))",
          "new": "            pass"
        }
      ],
      "expect": "internal unresolved claims remain explicit"
    },
    {
      "test": "test_broad_then_narrow_dossier",
      "name": "erase declared leaf scope order during provenance comparison",
      "edits": [
        {
          "file": "worktree.py",
          "old": "artifact.scope!=tuple(node['scope'])",
          "new": "set(artifact.scope)!=set(node['scope'])"
        }
      ],
      "expect": "leaf scope retains its original declared topic order"
    }
  ]
}
