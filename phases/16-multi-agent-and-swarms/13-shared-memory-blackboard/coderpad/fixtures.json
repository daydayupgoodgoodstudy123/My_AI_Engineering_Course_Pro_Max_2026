{
  "core": {
    "function": "compact_memory",
    "cases": [
      {
        "args": [
          [
            {
              "id": "a",
              "timestamp": 1,
              "text": "old"
            },
            {
              "id": "a",
              "timestamp": 2,
              "text": "new"
            }
          ],
          1
        ],
        "expected": [
          {
            "id": "a",
            "timestamp": 2,
            "text": "new"
          }
        ]
      },
      {
        "args": [
          [],
          1
        ],
        "expected": []
      },
      {
        "args": [
          [
            {
              "id": "a",
              "timestamp": 1,
              "text": "x"
            }
          ],
          0
        ],
        "expected": []
      },
      {
        "args": [
          [
            {
              "id": "b",
              "timestamp": 1,
              "text": "b"
            },
            {
              "id": "a",
              "timestamp": 1,
              "text": "a"
            }
          ],
          1
        ],
        "expected": [
          {
            "id": "a",
            "timestamp": 1,
            "text": "a"
          }
        ]
      },
      {
        "args": [
          [],
          -1
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            {
              "id": "a",
              "timestamp": 1,
              "text": "x"
            },
            {
              "id": "a",
              "timestamp": 1,
              "text": "y"
            }
          ],
          1
        ],
        "expected": [
          {
            "id": "a",
            "timestamp": 1,
            "text": "y"
          }
        ]
      }
    ]
  },
  "bonus": {
    "function": "cache_replay",
    "cases": [
      {
        "args": [
          [
            {
              "op": "put",
              "key": "a",
              "time": 0,
              "value": 1
            },
            {
              "op": "get",
              "key": "a",
              "time": 1
            },
            {
              "op": "get",
              "key": "a",
              "time": 2
            }
          ],
          2
        ],
        "expected": [
          1,
          null
        ]
      },
      {
        "args": [
          [
            {
              "op": "delete",
              "key": "a",
              "time": 0
            }
          ],
          1
        ],
        "raises": "ValueError"
      }
    ]
  }
}
