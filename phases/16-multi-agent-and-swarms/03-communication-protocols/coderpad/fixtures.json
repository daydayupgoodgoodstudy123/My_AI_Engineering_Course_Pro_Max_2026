{
  "core": {
    "function": "rpc_request",
    "cases": [
      {
        "args": [
          0,
          "tools/list",
          {}
        ],
        "expected": {
          "jsonrpc": "2.0",
          "id": 0,
          "method": "tools/list",
          "params": {}
        }
      },
      {
        "args": [
          "a",
          "call",
          {
            "x": 1
          }
        ],
        "expected": {
          "jsonrpc": "2.0",
          "id": "a",
          "method": "call",
          "params": {
            "x": 1
          }
        }
      },
      {
        "args": [
          true,
          "call",
          {}
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          1,
          "",
          {}
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          1,
          "call",
          []
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          "",
          "call",
          {}
        ],
        "raises": "ValueError"
      }
    ]
  },
  "bonus": {
    "function": "replay_requests",
    "cases": [
      {
        "args": [
          [
            {
              "id": "a",
              "payload": 1
            },
            {
              "id": "a",
              "payload": 1
            }
          ]
        ],
        "expected": {
          "executed": [
            "a"
          ],
          "replayed": [
            "a"
          ]
        }
      },
      {
        "args": [
          [
            {
              "id": "a",
              "payload": 1
            },
            {
              "id": "a",
              "payload": true
            }
          ]
        ],
        "raises": "ValueError"
      }
    ]
  }
}
