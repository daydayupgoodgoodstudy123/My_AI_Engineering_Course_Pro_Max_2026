{
  "core": {
    "function": "merge_pair",
    "cases": [
      {
        "args": [
          [
            "a",
            "b",
            "a",
            "b"
          ],
          [
            "a",
            "b"
          ]
        ],
        "expected": [
          "ab",
          "ab"
        ]
      },
      {
        "args": [
          [
            "a",
            "a",
            "a"
          ],
          [
            "a",
            "a"
          ]
        ],
        "expected": [
          "aa",
          "a"
        ]
      },
      {
        "args": [
          [],
          [
            "a",
            "b"
          ]
        ],
        "expected": []
      },
      {
        "args": [
          [
            "x"
          ],
          [
            "a",
            "b"
          ]
        ],
        "expected": [
          "x"
        ]
      },
      {
        "args": [
          [],
          [
            "a"
          ]
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            "a",
            "b",
            "b"
          ],
          [
            "a",
            "b"
          ]
        ],
        "expected": [
          "ab",
          "b"
        ]
      }
    ]
  },
  "bonus": {
    "function": "tokenize",
    "cases": [
      {
        "args": [
          "Hello, WORLD!"
        ],
        "expected": [
          "hello",
          "world"
        ]
      },
      {
        "args": [
          ""
        ],
        "expected": []
      }
    ]
  }
}
