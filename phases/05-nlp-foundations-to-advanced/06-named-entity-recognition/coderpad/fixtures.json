{
  "core": {
    "function": "bio_spans",
    "cases": [
      {
        "args": [
          [
            "B-PER",
            "I-PER",
            "O"
          ]
        ],
        "expected": [
          {
            "type": "PER",
            "start": 0,
            "end": 2
          }
        ]
      },
      {
        "args": [
          [
            "I-X"
          ]
        ],
        "expected": [
          {
            "type": "X",
            "start": 0,
            "end": 1
          }
        ]
      },
      {
        "args": [
          [
            "B-X",
            "B-X"
          ]
        ],
        "expected": [
          {
            "type": "X",
            "start": 0,
            "end": 1
          },
          {
            "type": "X",
            "start": 1,
            "end": 2
          }
        ]
      },
      {
        "args": [
          []
        ],
        "expected": []
      },
      {
        "args": [
          [
            "O"
          ]
        ],
        "expected": []
      },
      {
        "args": [
          [
            "PER"
          ]
        ],
        "raises": "ValueError"
      }
    ]
  },
  "bonus": {
    "function": "tokenize",
    "cases": [
      {
        "args": [
          "Hello, WORLD!"
        ],
        "expected": [
          "hello",
          "world"
        ]
      },
      {
        "args": [
          ""
        ],
        "expected": []
      }
    ]
  }
}
