{
  "core": {
    "function": "tokenize",
    "cases": [
      {
        "args": [
          "Hello, WORLD!"
        ],
        "expected": [
          "hello",
          "world"
        ]
      },
      {
        "args": [
          ""
        ],
        "expected": []
      },
      {
        "args": [
          "a-b_2"
        ],
        "expected": [
          "a",
          "b",
          "2"
        ]
      },
      {
        "args": [
          "2026 AI"
        ],
        "expected": [
          "2026",
          "ai"
        ]
      },
      {
        "args": [
          "你好"
        ],
        "expected": []
      },
      {
        "args": [
          "A  A"
        ],
        "expected": [
          "a",
          "a"
        ]
      }
    ]
  },
  "bonus": {
    "function": "ngram_counts",
    "cases": [
      {
        "args": [
          [
            "a",
            "b",
            "a"
          ],
          1
        ],
        "expected": {
          "[\"a\"]": 2,
          "[\"b\"]": 1
        }
      },
      {
        "args": [
          [
            "a"
          ],
          true
        ],
        "raises": "ValueError"
      }
    ]
  }
}
