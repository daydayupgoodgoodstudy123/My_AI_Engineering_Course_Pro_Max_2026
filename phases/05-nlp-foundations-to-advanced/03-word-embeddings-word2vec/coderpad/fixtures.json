{
  "core": {
    "function": "ngram_counts",
    "cases": [
      {
        "args": [
          [
            "a",
            "b",
            "a"
          ],
          1
        ],
        "expected": {
          "[\"a\"]": 2,
          "[\"b\"]": 1
        }
      },
      {
        "args": [
          [
            "a",
            "b",
            "a"
          ],
          2
        ],
        "expected": {
          "[\"a\", \"b\"]": 1,
          "[\"b\", \"a\"]": 1
        }
      },
      {
        "args": [
          [],
          2
        ],
        "expected": {}
      },
      {
        "args": [
          [
            "a"
          ],
          2
        ],
        "expected": {}
      },
      {
        "args": [
          [
            "a"
          ],
          0
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            "a"
          ],
          true
        ],
        "raises": "ValueError"
      }
    ]
  },
  "bonus": {
    "function": "cosine",
    "cases": [
      {
        "args": [
          [
            1,
            0
          ],
          [
            1,
            0
          ]
        ],
        "expected": 1
      },
      {
        "args": [
          [
            1
          ],
          []
        ],
        "raises": "ValueError"
      }
    ]
  }
}
