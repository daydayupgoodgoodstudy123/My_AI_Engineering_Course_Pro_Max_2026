{
  "core": {
    "function": "git_plan",
    "cases": [
      {
        "args": [
          [
            {
              "path": "a",
              "status": "added"
            }
          ]
        ],
        "expected": {
          "added": [
            "a"
          ],
          "modified": [],
          "deleted": []
        }
      },
      {
        "args": [
          []
        ],
        "expected": {
          "added": [],
          "modified": [],
          "deleted": []
        }
      },
      {
        "args": [
          [
            {
              "path": "z",
              "status": "modified"
            },
            {
              "path": "a",
              "status": "modified"
            }
          ]
        ],
        "expected": {
          "added": [],
          "modified": [
            "a",
            "z"
          ],
          "deleted": []
        }
      },
      {
        "args": [
          [
            {
              "path": "a",
              "status": "unknown"
            }
          ]
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            {
              "path": "a",
              "status": "added"
            },
            {
              "path": "a",
              "status": "deleted"
            }
          ]
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            {
              "path": "a b",
              "status": "deleted"
            }
          ]
        ],
        "expected": {
          "added": [],
          "modified": [],
          "deleted": [
            "a b"
          ]
        }
      }
    ]
  },
  "bonus": {
    "function": "evidence_gate",
    "cases": [
      {
        "args": [
          {
            "tests": true
          },
          [
            "tests"
          ]
        ],
        "expected": {
          "ready": true,
          "failed": []
        }
      },
      {
        "args": [
          {},
          [
            "tests"
          ]
        ],
        "expected": {
          "ready": false,
          "failed": [
            "tests"
          ]
        }
      }
    ]
  }
}
