{
  "core": {
    "function": "permission_decision",
    "cases": [
      {
        "args": [
          "write",
          [
            "write"
          ],
          true,
          false
        ],
        "expected": "ask"
      },
      {
        "args": [
          "write",
          [
            "write"
          ],
          true,
          true
        ],
        "expected": "allow"
      },
      {
        "args": [
          "write",
          [],
          true,
          true
        ],
        "expected": "deny"
      },
      {
        "args": [
          "read",
          [
            "read"
          ],
          false,
          false
        ],
        "expected": "allow"
      },
      {
        "args": [
          "x",
          [],
          1,
          false
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          "x",
          [],
          false,
          false
        ],
        "expected": "deny"
      }
    ]
  },
  "bonus": {
    "function": "command_review",
    "cases": [
      {
        "args": [
          [
            "python3",
            "check.py"
          ],
          [
            [
              "python3",
              "check.py"
            ]
          ]
        ],
        "expected": true
      },
      {
        "args": [
          [
            "python3",
            "check.py",
            "--upload"
          ],
          [
            [
              "python3",
              "check.py"
            ]
          ]
        ],
        "expected": false
      }
    ]
  }
}
