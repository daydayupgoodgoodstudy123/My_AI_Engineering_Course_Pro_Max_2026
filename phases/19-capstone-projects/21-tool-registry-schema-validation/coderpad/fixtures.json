{
  "core": {
    "function": "validate_arguments",
    "cases": [
      {
        "args": [
          {
            "x": "integer"
          },
          {
            "x": 2
          }
        ],
        "expected": true
      },
      {
        "args": [
          {
            "x": "integer"
          },
          {
            "x": true
          }
        ],
        "expected": false
      },
      {
        "args": [
          {
            "x": "string"
          },
          {
            "x": "a",
            "extra": 1
          }
        ],
        "expected": false
      },
      {
        "args": [
          {},
          {}
        ],
        "expected": true
      },
      {
        "args": [
          {
            "x": "boolean"
          },
          {
            "x": 1
          }
        ],
        "expected": false
      },
      {
        "args": [
          {
            "x": "number"
          },
          {
            "x": 1
          }
        ],
        "expected": false
      }
    ]
  },
  "bonus": {
    "function": "validate_config",
    "cases": [
      {
        "args": [
          {
            "x": 1
          },
          [
            "x"
          ],
          []
        ],
        "expected": {
          "missing": [],
          "unknown": [],
          "valid": true
        }
      },
      {
        "args": [
          {},
          [
            "x"
          ],
          []
        ],
        "expected": {
          "missing": [
            "x"
          ],
          "unknown": [],
          "valid": false
        }
      }
    ]
  }
}
