{
  "core": {
    "function": "git_plan",
    "cases": [
      {
        "args": [
          [
            {
              "path": "a",
              "status": "added"
            }
          ]
        ],
        "expected": {
          "added": [
            "a"
          ],
          "modified": [],
          "deleted": []
        }
      },
      {
        "args": [
          []
        ],
        "expected": {
          "added": [],
          "modified": [],
          "deleted": []
        }
      },
      {
        "args": [
          [
            {
              "path": "z",
              "status": "modified"
            },
            {
              "path": "a",
              "status": "modified"
            }
          ]
        ],
        "expected": {
          "added": [],
          "modified": [
            "a",
            "z"
          ],
          "deleted": []
        }
      },
      {
        "args": [
          [
            {
              "path": "a",
              "status": "unknown"
            }
          ]
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            {
              "path": "a",
              "status": "added"
            },
            {
              "path": "a",
              "status": "deleted"
            }
          ]
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            {
              "path": "a b",
              "status": "deleted"
            }
          ]
        ],
        "expected": {
          "added": [],
          "modified": [],
          "deleted": [
            "a b"
          ]
        }
      }
    ]
  },
  "bonus": {
    "function": "manifest",
    "cases": [
      {
        "args": [
          {
            "a": ""
          }
        ],
        "expected": {
          "a": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        }
      },
      {
        "args": [
          {
            "/a": ""
          }
        ],
        "raises": "ValueError"
      }
    ]
  }
}
