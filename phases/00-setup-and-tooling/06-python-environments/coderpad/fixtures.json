{
  "core": {
    "function": "compatible_version",
    "cases": [
      {
        "args": [
          "3.12.1",
          "3.10.0",
          3
        ],
        "expected": true
      },
      {
        "args": [
          "3.9.9",
          "3.10.0",
          3
        ],
        "expected": false
      },
      {
        "args": [
          "4.0.0",
          "3.10.0",
          3
        ],
        "expected": false
      },
      {
        "args": [
          "3.10.0",
          "3.10.0",
          3
        ],
        "expected": true
      },
      {
        "args": [
          "3.10",
          "3.0.0",
          3
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          "3.1.0-beta",
          "3.0.0",
          3
        ],
        "raises": "ValueError"
      }
    ]
  },
  "bonus": {
    "function": "validate_config",
    "cases": [
      {
        "args": [
          {
            "x": 1
          },
          [
            "x"
          ],
          []
        ],
        "expected": {
          "missing": [],
          "unknown": [],
          "valid": true
        }
      },
      {
        "args": [
          {},
          [
            "x"
          ],
          []
        ],
        "expected": {
          "missing": [
            "x"
          ],
          "unknown": [],
          "valid": false
        }
      }
    ]
  }
}
