{
  "core": {
    "function": "command_review",
    "cases": [
      {
        "args": [
          [
            "python3",
            "check.py"
          ],
          [
            [
              "python3",
              "check.py"
            ]
          ]
        ],
        "expected": true
      },
      {
        "args": [
          [
            "python3",
            "check.py",
            "--upload"
          ],
          [
            [
              "python3",
              "check.py"
            ]
          ]
        ],
        "expected": false
      },
      {
        "args": [
          "python3 check.py",
          [
            [
              "python3",
              "check.py"
            ]
          ]
        ],
        "expected": false
      },
      {
        "args": [
          [],
          [
            []
          ]
        ],
        "expected": false
      },
      {
        "args": [
          [
            1
          ],
          [
            [
              1
            ]
          ]
        ],
        "expected": false
      },
      {
        "args": [
          [
            "x"
          ],
          []
        ],
        "expected": false
      }
    ]
  },
  "bonus": {
    "function": "contained_path",
    "cases": [
      {
        "args": [
          "/work",
          "a/../b"
        ],
        "expected": "/work/b"
      },
      {
        "args": [
          "/work",
          "/secret"
        ],
        "raises": "ValueError"
      }
    ]
  }
}
