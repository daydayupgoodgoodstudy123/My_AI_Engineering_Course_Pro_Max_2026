          "b": {
            "count": 1,
            "total": 2,
            "max": 2
          }
        }
      },
      {
        "args": [
          [
            {
              "name": "x",
              "start": -1,
              "end": 0
            }
          ]
        ],
        "expected": {
          "x": {
            "count": 1,
            "total": 1,
            "max": 1
          }
        }
      }
    ]
  },
