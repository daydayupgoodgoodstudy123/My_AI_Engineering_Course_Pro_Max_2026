            "total": 5,
            "max": 3
          }
        }
      },
      {
        "args": [
          []
        ],
        "expected": {}
      },
      {
        "args": [
          [
            {
              "name": "x",
              "start": 1,
              "end": 1
            }
          ]
        ],
        "expected": {
          "x": {
            "count": 1,
            "total": 0,
            "max": 0
          }
        }
      },
      {
        "args": [
          [
            {
              "name": "x",
              "start": 2,
              "end": 1
            }
          ]
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            {
              "name": "a",
              "start": 0,
              "end": 1
            },
            {
              "name": "b",
              "start": 0,
              "end": 2
            }
          ]
        ],
        "expected": {
          "a": {
            "count": 1,
