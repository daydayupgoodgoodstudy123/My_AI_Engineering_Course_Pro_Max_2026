{
  "core": {
    "function": "environment_report",
    "cases": [
      {
        "args": [
          {
            "python": {
              "exit_code": 0,
              "output": "3.12"
            }
          },
          [
            "python"
          ]
        ],
        "expected": {
          "ready": true,
          "missing": [],
          "failed": []
        }
      },
      {
        "args": [
          {},
          [
            "python"
          ]
        ],
        "expected": {
          "ready": false,
          "missing": [
            "python"
          ],
          "failed": []
        }
      },
      {
        "args": [
          {
            "x": {
              "exit_code": 1,
              "output": "bad"
            }
          },
          [
            "x"
          ]
        ],
        "expected": {
          "ready": false,
          "missing": [],
          "failed": [
            "x"
          ]
        }
      },
      {
        "args": [
          {},
          []
        ],
        "expected": {
          "ready": true,
          "missing": [],
          "failed": []
        }
      },
      {
        "args": [
          {
            "x": {
              "exit_code": 0,
              "output": " "
            }
          },
          [
            "x"
          ]
        ],
        "expected": {
          "ready": false,
          "missing": [],
          "failed": [
            "x"
          ]
        }
      },
      {
        "args": [
          {},
          [
            "b",
            "a",
            "a"
          ]
        ],
        "expected": {
          "ready": false,
          "missing": [
            "a",
            "b"
          ],
          "failed": []
        }
      }
    ]
  },
  "bonus": {
    "function": "compatible_version",
    "cases": [
      {
        "args": [
          "3.12.1",
          "3.10.0",
          3
        ],
        "expected": true
      },
      {
        "args": [
          "3.1.0-beta",
          "3.0.0",
          3
        ],
        "raises": "ValueError"
      }
    ]
  }
}
