{
  "core": {
    "function": "contained_path",
    "cases": [
      {
        "args": [
          "/work",
          "a/../b"
        ],
        "expected": "/work/b"
      },
      {
        "args": [
          "/work",
          "."
        ],
        "expected": "/work"
      },
      {
        "args": [
          "/",
          "a"
        ],
        "expected": "/a"
      },
      {
        "args": [
          "/work",
          "../x"
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          "/work",
          "/secret"
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          "/work",
          "a b"
        ],
        "expected": "/work/a b"
      }
    ]
  },
  "bonus": {
    "function": "permission_decision",
    "cases": [
      {
        "args": [
          "write",
          [
            "write"
          ],
          true,
          false
        ],
        "expected": "ask"
      },
      {
        "args": [
          "x",
          [],
          1,
          false
        ],
        "raises": "ValueError"
      }
    ]
  }
}
