{
  "core": {
    "function": "replay_requests",
    "cases": [
      {
        "args": [
          [
            {
              "id": "a",
              "payload": 1
            },
            {
              "id": "a",
              "payload": 1
            }
          ]
        ],
        "expected": {
          "executed": [
            "a"
          ],
          "replayed": [
            "a"
          ]
        }
      },
      {
        "args": [
          []
        ],
        "expected": {
          "executed": [],
          "replayed": []
        }
      },
      {
        "args": [
          [
            {
              "id": "a",
              "payload": 1
            },
            {
              "id": "a",
              "payload": 2
            }
          ]
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            {
              "id": "a",
              "payload": 1
            },
            {
              "id": "a",
              "payload": true
            }
          ]
        ],
        "raises": "ValueError"
      },
      {
        "args": [
          [
            {
              "id": "b",
              "payload": {}
            },
            {
              "id": "a",
              "payload": {}
            }
          ]
        ],
        "expected": {
          "executed": [
            "b",
            "a"
          ],
          "replayed": []
        }
      },
      {
        "args": [
          [
            {
              "id": "a",
              "payload": {
                "b": 2,
                "a": 1
              }
            },
            {
              "id": "a",
              "payload": {
                "a": 1,
                "b": 2
              }
            }
          ]
        ],
        "expected": {
          "executed": [
            "a"
          ],
          "replayed": [
            "a"
          ]
        }
      }
    ]
  },
  "bonus": {
    "function": "rate_limit",
    "cases": [
      {
        "args": [
          [
            0,
            0,
            1,
            10
          ],
          10,
          2
        ],
        "expected": [
          true,
          true,
          false,
          true
        ]
      },
      {
        "args": [
          [],
          0,
          1
        ],
        "raises": "ValueError"
      }
    ]
  }
}
